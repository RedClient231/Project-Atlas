<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Project Atlas - Android Virtual Space
  ~
  ~ Minimal XML theme for the Activity window.
  ~ Compose handles its own theming via AtlasTheme composable.
  ~ This theme only sets up the window chrome (status bar, nav bar).
  -->
<resources>

    <!-- Base Application Theme -->
    <style name="Theme.Atlas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Transparent status/navigation bars for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- No action bar (Compose handles its own top app bar) -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Edge-to-edge display -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Splash Theme (pre-Android 12 fallback) -->
    <style name="Theme.Atlas.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Atlas</item>
    </style>

</resources>
