<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Project Atlas - Android Virtual Space
  ~
  ~ FileProvider Paths Configuration
  ~ Defines the paths that can be shared via FileProvider for APK
  * sharing, installation, and data exchange with external apps.
  -->
<paths>

    <!-- External storage files directory -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- External storage cache directory -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- Internal app files directory (Context.getFilesDir()) -->
    <files-path
        name="internal_files"
        path="." />

    <!-- Internal app cache directory (Context.getCacheDir()) -->
    <cache-path
        name="internal_cache"
        path="." />

    <!--
        IMPORTANT: The virtual_root is under Context.getDataDir() (/data/data/{pkg}/virtual_root/),
        NOT under Context.getFilesDir() (/data/data/{pkg}/files/).
        Since FileProvider doesn't have a <data-path> tag, we use <root-path> to grant
        access to the entire app data directory. This is necessary for APK installation
        via the system package installer and Shizuku.
        
        The APK files are at: /data/data/{pkg}/virtual_root/apps/{target_pkg}/base.apk
        And the staging copies are at: /data/data/{pkg}/cache/atlas_install/
    -->
    <root-path
        name="app_data"
        path="." />

    <!-- Public Downloads directory for logcat exports and crash reports -->
    <external-path
        name="downloads"
        path="Download/" />

    <!-- AtlasReports subdirectory in Downloads -->
    <external-path
        name="atlas_reports"
        path="Download/AtlasReports/" />

</paths>
