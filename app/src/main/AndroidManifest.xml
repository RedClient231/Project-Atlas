<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Project Atlas - Android Virtual Space
  ~ Copyright (c) 2024 Atlas Contributors
  ~
  ~ AndroidManifest.xml
  ~ Declares all application components, permissions, and configuration
  ~ required for the virtual space engine to operate correctly.
  -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Network access for Shizuku communication and update checks -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground services for the virtual engine and logcat monitoring -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Prevent battery optimization from killing the virtual engine -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Storage permissions for APK import on all API levels -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- On Android 13+ (API 33) READ_MEDIA_IMAGES/VIDEO/AUDIO replace READ_EXTERNAL_STORAGE -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />

    <!-- Notifications for foreground service notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Query all installed packages for app listing and virtual installation -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Full file access for APK management on Android 11+ -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        android:minSdkVersion="30" />

    <!-- Wake lock to keep the virtual engine alive during active sessions -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Auto-start the engine service on device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Request install packages for APK/XAPK installation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Request delete packages for uninstallation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Access to installed app details (needed for cloning) -->
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE"
        tools:ignore="ProtectedPermissions" />

    <!-- Access to app ops for monitoring virtual process state -->
    <uses-permission android:name="android.permission.GET_TASKS"
        tools:ignore="ProtectedPermissions" />

    <!-- Real-time process monitoring -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Read phone state (some games check this) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />

    <!-- Access network state (some apps require this) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Vibration (games often use this) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Keep screen on during gameplay -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bluetooth (some multiplayer games) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        android:minSdkVersion="31" />

    <!-- Camera and microphone (apps inside virtual space may need these) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location (some apps require this) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Contacts (some social apps need this) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Calendar (some apps need this) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- SMS (some messaging apps) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Phone calls (some VOIP apps) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Body sensors (fitness apps) -->
    <uses-permission android:name="android.permission.BODY_SENSORS"
        android:minSdkVersion="20" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND"
        android:minSdkVersion="33" />

    <!-- Nearby devices (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:minSdkVersion="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:minSdkVersion="31" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:minSdkVersion="33" />

    <!-- Notification listener (to forward notifications from virtual apps) -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Alarm scheduling (some apps use AlarmManager) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:minSdkVersion="31" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />

    <!-- Install shortcuts on launcher (for virtual app shortcuts) -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />

    <!-- Overlay window (some apps need this for floating widgets) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Write settings (some apps modify system settings) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Change network state (some apps toggle network) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Modify audio settings (games often use this) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Background location (API 29+) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        android:minSdkVersion="29" />

    <!-- Read phone numbers (some apps need this) -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Answer phone calls (some VOIP apps) -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"
        android:minSdkVersion="26" />

    <!-- Process out of memory (helps with large games) -->
    <uses-permission android:name="android.permission.PROCESS_OUT_OF_MEMORY"
        tools:ignore="ProtectedPermissions" />

    <!-- Read app specific storage (Android 12+) -->
    <uses-permission android:name="android.permission.READ_APP_SPECIFIC_LOCALE"
        tools:ignore="ProtectedPermissions" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         QUERIES — Intent Resolution Visibility (Android 11+)
         ═══════════════════════════════════════════════════════════════════════ -->
    <queries>

        <!-- Packages: ability to resolve installed apps -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>

        <!-- Activities: resolve launchable activities for cloned apps -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>

        <!-- Services: discover Shizuku service -->
        <intent>
            <action android:name="dev.rikka.shizuku.intent.action.BIND_SERVICE" />
        </intent>

        <!-- Content providers: resolve file providers for APK sharing -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>

        <!-- XAPK file type -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/xapk" />
        </intent>

    </queries>

    <!-- ═══════════════════════════════════════════════════════════════════════
         APPLICATION
         ═══════════════════════════════════════════════════════════════════════ -->
    <application
        android:name=".AtlasApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atlas"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        tools:targetApi="35">

        <!-- ─── Native Hook Shared Library ─────────────────────────────────── -->
        <!--
            Install-time shared library containing native JNI hooks
            used by the Pine hooking framework for method interception.
        -->
        <uses-native-library
            android:name="libatlas_native.so"
            android:required="false" />

        <!-- ═══════════════════════════════════════════════════════════════════
             ACTIVITIES
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Main launcher activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default screen orientation for the launcher -->
            <meta-data
                android:name="android.app.default_orientation"
                android:value="unspecified" />

        </activity>

        <!--
            Virtual Stub Activity
            Proxy activity that bridges the Android system with virtual apps.
            When the user taps "Launch" on a virtual app, this activity is
            started with extras identifying the target package/activity.
            It then loads the virtual app's classes via a custom ClassLoader
            and starts the real activity within the Atlas host process.
        -->
        <activity
            android:name=".core.engine.VirtualStubActivity"
            android:exported="true"
            android:launchMode="standard"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="com.atlas.virtualspace.virtual"
            android:excludeFromRecents="true">

            <intent-filter>
                <action android:name="com.atlas.virtualspace.LAUNCH_VIRTUAL_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- ═══════════════════════════════════════════════════════════════════
             SERVICES
             ═══════════════════════════════════════════════════════════════════ -->

        <!--
            VirtualEngine Service
            Foreground service that hosts the virtual environment runtime.
            Manages cloned app processes, hook dispatch, and IPC coordination.
        -->
        <service
            android:name=".core.engine.VirtualEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:enabled="true">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Virtual environment runtime: manages cloned app processes, method hook dispatch via Pine framework, and inter-process communication coordination for virtualized applications" />

        </service>

        <!--
            Logcat Service
            Foreground service for real-time log capture and monitoring
            of virtualized application processes.
        -->
        <service
            android:name=".feature.logcat.LogcatService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true"
            android:enabled="true">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time log capture and monitoring of virtualized application processes for debugging and diagnostics" />

        </service>

        <!-- ═══════════════════════════════════════════════════════════════════
             BROADCAST RECEIVERS
             ═══════════════════════════════════════════════════════════════════ -->

        <!--
            Boot Completed Receiver
            Restores the virtual engine state after device reboot
            if the user has enabled auto-start.
        -->
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:exported="true"
            android:directBootAware="false"
            android:enabled="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>

        </receiver>

        <!-- ═══════════════════════════════════════════════════════════════════
             CONTENT PROVIDERS
             ═══════════════════════════════════════════════════════════════════ -->

        <!--
            FileProvider for APK Sharing
            Enables secure sharing of APK files between Atlas and external
            applications (e.g., package installers, file managers).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />

        </provider>

        <!--
            Shizuku Provider
            Content provider required by the Shizuku library for
            elevated IPC operations without root access.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:enabled="true"
            android:multiprocess="false" />

        <!-- ═══════════════════════════════════════════════════════════════════
             META-DATA
             ═══════════════════════════════════════════════════════════════════ -->

        <!-- Hilt: Enable aggregated compile-time dependency injection -->
        <meta-data
            android:name="dagger.hilt.android.HiltAndroidApp"
            android:value="" />

    </application>

</manifest>
